{
  "name": "dongnam-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/worker.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf:login": "wrangler login --scopes account:read user:read workers_scripts:write workers_routes:write workers_tail:read",
    "cf:whoami": "wrangler whoami"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.168.0"
  }
}
